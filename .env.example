# Supabase — Settings > Database > Connection string > URI (Transaction pooler port 6543)
DATABASE_URL=postgresql://postgres.[project-ref]:[PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# JWT Secret (minimum 32 caractères)
JWT_SECRET=change-moi-secret-minimum-32-caracteres

# ── Mail-passerelle Opération Show-Up ─────────────────────────────────────
# Sur Vercel le SMTP sortant est bloqué : l'envoi passe par l'API Gmail
# (OAuth Google Cloud — l'expéditeur reste la vraie adresse @gmail.com).
# Setup : projet Google Cloud + Gmail API + OAuth client (redirect URI
# https://developers.google.com/oauthplayground) + refresh token via
# le OAuth Playground (scope https://www.googleapis.com/auth/gmail.send).
GMAIL_CLIENT_ID=xxxxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-...
GMAIL_REFRESH_TOKEN=1//...
# Identité d'expéditeur : l'adresse doit être LE compte Gmail ci-dessus
SMTP_FROM="Rémi — Payment Flow <adresse@gmail.com>"

# ── SMS de confirmation (envoyé au prospect quand il clique CONFIRMER) ────
# API SMS transactionnel Brevo : crédits prépayés à acheter dans le compte
# (~0,045 €/SMS France). Sans BREVO_API_KEY, le SMS est simplement sauté.
BREVO_API_KEY=xkeysib-...
# Expéditeur affiché sur le SMS : alphanumérique, 11 caractères max, sans espaces
SMS_SENDER=PaymentFlow

# Secret protégeant /api/cron/reminders (relances J-1 / H-2) — chaîne aléatoire
# longue, à passer par le planificateur en header « Authorization: Bearer … »
# ou en paramètre ?key=. Générer : openssl rand -hex 24
CRON_SECRET=change-moi-chaine-aleatoire-longue

# Alternatives email (inutiles si GMAIL_* renseignées) :
# SMTP_HOST=smtp.gmail.com         # SMTP direct — hors Vercel uniquement
# SMTP_PORT=587
# SMTP_USER=adresse@gmail.com
# SMTP_PASS=mot-de-passe-application

# URL publique de l'app (pour le lien CONFIRMER du mail) ; sinon origine de la requête
APP_URL=https://votre-domaine.vercel.app

# Fallback WhatsApp après le clic CONFIRMER : utilisé seulement si le setter
# assigné n'a pas de numéro (users.phone). Format international, sans +.
WHATSAPP_CONFIRM_PHONE=33612345678

# Optionnel — notification dans un groupe WhatsApp à la confirmation (via whapi.cloud,
# API non officielle : utiliser un numéro dédié, pas un numéro personnel).
# WHAPI_TOKEN=...
# WHAPI_GROUP_ID=1203630XXXXXXXX@g.us
