# Supabase — Settings > Database > Connection string > URI (Transaction pooler port 6543)
DATABASE_URL=postgresql://postgres.[project-ref]:[PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# JWT Secret (minimum 32 caractères)
JWT_SECRET=change-moi-secret-minimum-32-caracteres

# ── Mail-passerelle Opération Show-Up ─────────────────────────────────────
# Envoi via Gmail : activer la validation en 2 étapes sur le compte, puis créer
# un « mot de passe d'application » (myaccount.google.com/apppasswords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=adresse@gmail.com
SMTP_PASS=mot-de-passe-application-16-caracteres
SMTP_FROM="Rémi — Payment Flow <adresse@gmail.com>"

# URL publique de l'app (pour le lien CONFIRMER du mail) ; sinon origine de la requête
APP_URL=https://votre-domaine.vercel.app

# WhatsApp ouvert après le clic CONFIRMER (format international sans +)
WHATSAPP_CONFIRM_PHONE=33612345678

# Optionnel — notification dans un groupe WhatsApp à la confirmation (via whapi.cloud,
# API non officielle : utiliser un numéro dédié, pas un numéro personnel).
# WHAPI_TOKEN=...
# WHAPI_GROUP_ID=1203630XXXXXXXX@g.us
